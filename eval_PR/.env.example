# ========================================
# eval_PR Environment Configuration
# ========================================
# Copy this file to .env and fill in your API keys.
# All variables are optional — eval_PR will run without keys, but output will be labeled as placeholder.
#
# Priority:
#   1. Variables defined in this .env file
#   2. Environment variables already set in shell/system
#   3. Hardcoded defaults in config.py
#
# Installation:
#   cp .env.example .env

# ========================================
# LLM Provider API Keys
# ========================================
# Leave all blank to test end-to-end with placeholder output (safe, no charges)

# Anthropic / Claude models
ANTHROPIC_API_KEY=

# DeepSeek models (via Anthropic-compatible API)
DEEPSEEK_API_KEY=
LLM_API_KEY=

# OpenAI / GPT models
OPENAI_API_KEY=

# Google Gemini models
GEMINI_API_KEY=

# ========================================
# LLM Model Configuration
# ========================================
# Default judge model (audit auditor)
# Tested: claude-sonnet-5, claude-opus-4-8, claude-opus-4-7, deepseek-v4-pro, gpt-4o
EVAL_PR_JUDGE_MODEL=deepseek-v4-pro

# Default baseline model (zero-shot baseline for comparison)
# Should differ from judge model to avoid self-bias
# Tested: deepseek-v4-pro, deepseek-v4-flash, claude-sonnet-5, gpt-4o
EVAL_PR_BASELINE_MODEL=deepseek-v4-pro

# DeepSeek API endpoint (Anthropic-compatible interface)
LLM_BASE_URL=https://api.deepseek.com/anthropic

# Max output tokens per LLM call
EVAL_PR_MAX_TOKENS=3000

# ========================================
# Optional Debugging / Logging
# ========================================
# LOG_LEVEL=DEBUG
# EVAL_PR_VERBOSE=false
